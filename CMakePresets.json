{
    "version": 6,
    "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_FLAGS": "-march=x86-64-v2",
                "CMAKE_CXX_FLAGS": "-march=x86-64-v2"
            },
            "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}
        },
        {"name": "debug", "displayName": "Debug", "inherits": "base",
         "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
        {"name": "release", "displayName": "Release", "inherits": "base",
         "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
        {"name": "relwithdebinfo", "displayName": "RelWithDebInfo", "inherits": "base",
         "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}},
        {
            "name": "linux-core",
            "displayName": "Linux tools and portable core (no game runtime)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/out/build/linux-core",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "XBE_BUILD_RUNTIME": "OFF",
                "XBE_BUILD_TESTS": "ON"
            },
            "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}
        },
        {"name": "linux-window", "inherits": "linux-core",
         "displayName": "Linux standalone SDL window diagnostic",
         "binaryDir": "${sourceDir}/out/build/linux-window",
         "cacheVariables": {"XBE_BUILD_WINDOW_TEST": "ON", "SDL_WAYLAND": "OFF", "SDL_KMSDRM": "OFF"}},
        {"name": "linux-game", "inherits": "linux-core",
         "displayName": "Experimental native Linux game (requires local assets, Vulkan and DXC)",
         "binaryDir": "${sourceDir}/out/build/linux-game",
         "cacheVariables": {"XBE_BUILD_RUNTIME": "ON", "XBE_EXPERIMENTAL_LINUX_RUNTIME": "ON", "SDL_WAYLAND": "OFF", "SDL_KMSDRM": "OFF"}}
    ],
    "buildPresets": [
        {"name": "debug", "configurePreset": "debug"},
        {"name": "release", "configurePreset": "release"},
        {"name": "relwithdebinfo", "configurePreset": "relwithdebinfo"},
        {"name": "linux-core", "configurePreset": "linux-core"},
        {"name": "linux-window", "configurePreset": "linux-window"},
        {"name": "linux-game", "configurePreset": "linux-game", "targets": ["GenmaOnimusha"]}
    ],
    "testPresets": [
        {"name": "linux-core", "configurePreset": "linux-core",
         "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
        {"name": "linux-window", "configurePreset": "linux-window",
         "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}}
    ]
}
